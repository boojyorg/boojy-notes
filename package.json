{
  "name": "boojy-notes",
  "private": true,
  "version": "0.6.1",
  "description": "Boojy Notes",
  "author": "Tyr Bujac",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "dev:web": "ELECTRON_DISABLE=1 vite",
    "build": "vite build",
    "build:electron": "node -e \"fs.rmSync('dist-electron',{recursive:true,force:true})\" && vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:electron": "vite build && playwright test -c playwright.electron.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "chokidar": "^5.0.0",
    "electron": "^42.11.2",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "lucide-react": "^1.33.0",
    "markdown-it": "^14.3.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^1.0.4",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "build": {
    "appId": "org.boojy.notes",
    "productName": "Boojy Notes",
    "copyright": "Copyright 2026 Tyr Bujac",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/boojy-notes-app-icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/boojy-notes-app-icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/boojy-notes-app-icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
