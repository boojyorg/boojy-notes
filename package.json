{
  "name": "boojy-notes",
  "private": true,
  "version": "0.19.0",
  "description": "Boojy Notes",
  "author": "Tyr Bujac",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "vite",
    "dev:tweak": "vite --mode tweak",
    "dev:web": "vite --mode web",
    "dev:phone": "vite --mode phone --port 5175 --strictPort",
    "build": "vite build",
    "build:electron": "node -e \"fs.rmSync('dist-electron',{recursive:true,force:true})\" && vite build && electron-builder",
    "android": "node dev/android/run.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:electron": "vite build && playwright test -c playwright.electron.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.9.3",
    "electron-builder": "^26.16.1",
    "electron-updater": "^6.8.9",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "katex": "0.19.0",
    "lint-staged": "^17.6.0",
    "lucide-react": "^1.52.0",
    "markdown-it": "^15.0.3",
    "mermaid": "12.1.0",
    "pdfjs-dist": "^6.4.299",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ],
    "overrides": {
      "xcode>uuid": "^11.1.1"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "build": {
    "appId": "org.boojy.notes",
    "productName": "Boojy Notes",
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "description": "Markdown note",
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "copyright": "Copyright 2026 Tyr Bujac",
    "publish": [
      {
        "provider": "github"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/boojy-notes-app-icon.png",
      "assets/boojy-notes-app-icon-full.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/boojy-notes-app-icon-full.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/boojy-notes-app-icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/boojy-notes-app-icon-full.png",
      "category": "Office",
      "executableName": "boojy-notes",
      "artifactName": "Boojy-Notes-${version}-${arch}.${ext}",
      "synopsis": "Markdown notes you own",
      "maintainer": "Tyr Bujac <tyr@boojy.org>",
      "vendor": "Boojy"
    }
  },
  "homepage": "https://boojy.org/notes",
  "dependencies": {
    "koffi": "^3.3.4"
  }
}
